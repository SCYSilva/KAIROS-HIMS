// backend/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncidentStatus {
  OPEN
  ACCEPTED
  REJECTED
  INVESTIGATING
  PENDING_ACTION
  UNDER_REVIEW
  CLOSED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CapaType {
  CORRECTIVE
  PREVENTIVE
}

enum CapaPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CapaStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ControlEffectiveness {
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  INEFFECTIVE
}

enum ControlStatus {
  PLANNED
  IN_PROGRESS
  VERIFIED
}

enum ReviewOutcome {
  APPROVED
  REVISION_REQUIRED
}

enum DisseminationStatus {
  SCHEDULED
  COMPLETED
}

model User {
  id                    Int        @id @default(autoincrement())
  email                 String     @unique
  password              String
  name                  String
  role                  String     // ADMIN, MANAGER, INVESTIGATOR, ACTION_OWNER, STAFF
  departmentId          Int
  department            Department @relation(fields: [departmentId], references: [id])
  
  reportedIncidents     Incident[] @relation("Reporter")
  investigatedIncidents Incident[] @relation("Investigator")
  ownedActions          Incident[] @relation("ActionOwner")
  
  // Relations for CAPA and Audit Logging
  assignedCapaActions   CapaAction[]        @relation("ActionOwnerAssignment")
  verifiedCapaActions   CapaAction[]        @relation("ActionVerifier")
  managementReviews     ManagementReview[]  @relation("ReviewAuthor")
  closedIncidents       Incident[]          @relation("IncidentCloser")
  auditLogs             IncidentAuditLog[]

  // Structured Investigation Relations
  leadInvestigations    Investigation[]           @relation("LeadInvestigator")
  investigationTeams    InvestigationTeamMember[]

  // Action Owner Module Relations
  assignedActionItems   ActionItem[]              @relation("ActionItemOwner")
  actionHistories       ActionHistory[]           @relation("ActionHistoryActor")
  actionNotifications   ActionNotification[]      @relation("ActionNotificationUser")

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  users     User[]
  incidents Incident[]
}

model Incident {
  id                Int            @id @default(autoincrement())
  title             String
  description       String
  severity          Severity
  category          String
  location          String
  status            IncidentStatus @default(OPEN)
  rejectionReason   String?

  // Root Cause Analysis & Investigation Findings
  rootCause                  String?        @map("root_cause")
  rootCauseCategory          String?        @map("root_cause_category")
  investigationFindings      String?        @map("investigation_findings")
  investigationReviewStatus  String?        @default("PENDING") // PENDING, APPROVED, REVISION_REQUESTED
  investigationReviewComment String?        @map("investigation_review_comment")

  correctiveAction           String?
  
  departmentId      Int
  department        Department     @relation(fields: [departmentId], references: [id])
  
  reporterId        Int
  reporter          User           @relation("Reporter", fields: [reporterId], references: [id])
  
  investigatorId    Int?
  investigator      User?          @relation("Investigator", fields: [investigatorId], references: [id])
  
  actionOwnerId     Int?
  actionOwner       User?          @relation("ActionOwner", fields: [actionOwnerId], references: [id])

  // Final Controlled Closure fields
  closedAt          DateTime?
  closureSummary    String?
  closedById        Int?
  closedBy          User?          @relation("IncidentCloser", fields: [closedById], references: [id])

  // Clinical Governance Sub-Entities
  attachments       IncidentAttachment[]
  capaActions       CapaAction[]
  controls          IncidentControl[]
  managementReview  ManagementReview?
  disseminations    LessonsDissemination[]
  auditLogs         IncidentAuditLog[]

  // Structured Investigation Link
  investigationRecord  Investigation?
  sourceRelationships  IncidentRelationship[] @relation("RelatedIncidentSource")
  targetRelationships  IncidentRelationship[] @relation("RelatedIncidentTarget")

  // Action Items (Decoupled Enterprise Action Governance)
  actionItems          ActionItem[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model IncidentAttachment {
  id         Int      @id @default(autoincrement())
  fileName   String
  filePath   String
  fileType   String

  incidentId Int
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())
}

model CapaAction {
  id                 Int          @id @default(autoincrement())
  incidentId         Int
  incident           Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  title              String
  actionType         CapaType     @default(CORRECTIVE)
  priority           CapaPriority @default(MEDIUM)
  dueDate            DateTime
  description        String
  
  actionOwnerId      Int
  actionOwner        User         @relation("ActionOwnerAssignment", fields: [actionOwnerId], references: [id])
  
  status             CapaStatus   @default(NOT_STARTED)
  evidenceNotes      String?
  
  // Verification Gate
  isVerified         Boolean      @default(false)
  verifiedAt         DateTime?
  verifiedById       Int?
  verifiedBy         User?        @relation("ActionVerifier", fields: [verifiedById], references: [id])
  verificationNotes  String?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model IncidentControl {
  id                  Int                  @id @default(autoincrement())
  incidentId          Int
  incident            Incident             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  controlType         String
  effectiveness       ControlEffectiveness @default(PARTIALLY_EFFECTIVE)
  status              ControlStatus        @default(PLANNED)
  failureReason       String?
  requiredImprovement String?
  targetDate          DateTime

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model ManagementReview {
  id                  Int           @id @default(autoincrement())
  incidentId          Int           @unique
  incident            Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  outcome             ReviewOutcome @default(APPROVED)
  lessonsLearned      String
  outcomeComments     String
  followUpMonitoring  String
  
  reviewedById        Int
  reviewedBy          User          @relation("ReviewAuthor", fields: [reviewedById], references: [id])
  reviewedAt          DateTime      @default(now())
}

model LessonsDissemination {
  id            Int                 @id @default(autoincrement())
  incidentId    Int
  incident      Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  audience      String
  scheduledDate DateTime
  status        DisseminationStatus @default(SCHEDULED)

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model IncidentAuditLog {
  id         Int      @id @default(autoincrement())
  incidentId Int
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  
  action     String   // e.g., TRIAGE_ACCEPTED, RECORD_CORRECTED, CAPA_CREATED, CAPA_VERIFIED, INCIDENT_CLOSED
  reason     String?
  changes    String?  // Serialized JSON of changed diffs
  createdAt  DateTime @default(now())
}

enum InvestigationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

enum InvestigationMethod {
  FIVE_WHYS
  FISHBONE
  FAULT_TREE
  TIMELINE_ANALYSIS
  OTHER
}

enum AiFeedbackAction {
  ACCEPTED
  DISMISSED
}

model Investigation {
  id                    Int                         @id @default(autoincrement())
  incidentId            Int                         @unique
  incident              Incident                    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  leadInvestigatorId    Int
  leadInvestigator      User                        @relation("LeadInvestigator", fields: [leadInvestigatorId], references: [id])
  status                InvestigationStatus         @default(DRAFT)
  startDate             DateTime?
  endDate               DateTime?
  method                InvestigationMethod?
  methodOther           String?
  findingsSummary       String?
  rootCauseCategory     String?
  rootCauseSubcategory  String?
  rootCauseDescription  String?
  rootCauseMethod        InvestigationMethod?
  rootCauseDetail        String?
  systemicIssue         Boolean                     @default(false)
  revisionNumber        Int                         @default(1)
  submittedAt           DateTime?
  approvedAt            DateTime?
  lockedAt              DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  teamMembers           InvestigationTeamMember[]
  contributingFactors   InvestigationFactor[]
  witnesses             InvestigationWitness[]
  timeline              InvestigationTimelineEvent[]
  evidence              InvestigationEvidence[]
  aiFeedback            InvestigationAiFeedback[]

  @@index([leadInvestigatorId, status])
  @@index([startDate, endDate])
}

model InvestigationTeamMember {
  investigationId Int
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  userId          Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String        @default("TEAM_MEMBER")
  addedAt         DateTime      @default(now())

  @@id([investigationId, userId])
  @@index([userId])
}

model InvestigationFactor {
  id              Int           @id @default(autoincrement())
  investigationId Int
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  category        String
  description     String
  createdAt       DateTime      @default(now())

  @@index([investigationId])
}

model InvestigationWitness {
  id              Int           @id @default(autoincrement())
  investigationId Int
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  name            String
  roleOrContact   String?
  statement       String?
  interviewedAt   DateTime?
  createdAt       DateTime      @default(now())

  @@index([investigationId])
}

model InvestigationTimelineEvent {
  id              Int           @id @default(autoincrement())
  investigationId Int
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  occurredAt      DateTime
  title           String
  description     String
  source          String?
  createdAt       DateTime      @default(now())

  @@index([investigationId, occurredAt])
}

model InvestigationEvidence {
  id              Int           @id @default(autoincrement())
  investigationId Int
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  attachmentId    Int?
  label           String
  reference       String?
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([investigationId])
}

model IncidentRelationship {
  id               Int      @id @default(autoincrement())
  sourceIncidentId Int
  sourceIncident   Incident @relation("RelatedIncidentSource", fields: [sourceIncidentId], references: [id], onDelete: Cascade)
  targetIncidentId Int
  targetIncident   Incident @relation("RelatedIncidentTarget", fields: [targetIncidentId], references: [id], onDelete: Cascade)
  reason           String
  createdAt        DateTime @default(now())

  @@unique([sourceIncidentId, targetIncidentId])
  @@index([targetIncidentId])
}

model InvestigationAiFeedback {
  id              Int              @id @default(autoincrement())
  investigationId Int
  investigation   Investigation    @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  feature         String
  resultKey       String
  action          AiFeedbackAction
  reason          String?
  modelVersion    String
  createdAt       DateTime         @default(now())

  @@index([investigationId, feature])
}

// ==========================================
// Action Owner & CAPA Governance Subsystem
// ==========================================

enum ActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionReviewStatus {
  ACTIVE
  RETURNED_FOR_REVISION
  COMPLETED_PENDING_VERIFICATION
  VERIFIED
}

enum ActionType {
  IMMEDIATE
  CORRECTIVE
  PREVENTIVE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ActionItem {
  id                    Int                 @id @default(autoincrement())
  incidentId            Int
  incident              Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  ownerId               Int
  owner                 User                @relation("ActionItemOwner", fields: [ownerId], references: [id])
  title                 String
  description           String
  type                  ActionType          @default(CORRECTIVE)
  priority              Priority            @default(MEDIUM)
  dueDate               DateTime
  status                ActionStatus        @default(OPEN)
  reviewStatus          ActionReviewStatus  @default(ACTIVE)
  progressNote          String?
  verificationNotes     String?
  managerReviewComment  String?
  completedAt           DateTime?
  effectiveness         String?
  effectivenessScore    Int?
  completionRiskScore   Float?
  riskExplanation       Json?
  
  evidence              ActionEvidence[]
  history               ActionHistory[]
  notifications         ActionNotification[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([ownerId, status])
  @@index([dueDate, status])
  @@index([incidentId])
}

model ActionEvidence {
  id            Int         @id @default(autoincrement())
  actionItemId  Int
  actionItem    ActionItem  @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  fileName      String
  fileType      String
  fileSize      Int
  filePath      String
  uploadedAt    DateTime    @default(now())

  @@index([actionItemId, uploadedAt])
}

model ActionHistory {
  id            Int         @id @default(autoincrement())
  actionItemId  Int
  actionItem    ActionItem  @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  actorId       Int?
  actor         User?       @relation("ActionHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  eventType     String      // ASSIGNED, PROGRESS_UPDATED, SUBMITTED_FOR_VERIFICATION, RETURNED, VERIFIED, EVIDENCE_ADDED
  fromStatus    String?
  toStatus      String?
  note          String?
  createdAt     DateTime    @default(now())

  @@index([actionItemId, createdAt])
}

model ActionNotification {
  id           Int          @id @default(autoincrement())
  actionItemId Int
  actionItem   ActionItem   @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  userId       Int
  user         User         @relation("ActionNotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  type         String       // DUE_SOON, OVERDUE, RETURNED, VERIFIED
  title        String
  message      String
  readAt       DateTime?
  createdAt    DateTime     @default(now())

  @@unique([actionItemId, userId, type])
  @@index([userId, readAt, createdAt])
}
